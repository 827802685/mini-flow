{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // 生产承载 n8n.zjkl.dpdns.org 的 worker 名为 mini-flow（账户 ID=de9cc5...，勿混用）。
  // 用账户 ID 作 worker 名会导致 DO 命名空间前缀与账户冲突(code 10065)。
  "name": "mini-flow",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-12",
  "compatibility_flags": ["nodejs_compat"],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mini-flow-db",
      "database_id": "268512b4-7419-42ff-b0b5-dbb2f8db2880"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "CREDENTIALS",
      "id": "133f1b8aec3049e0a337f753ccd7ff63"
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "PUSH",
        "class_name": "PushConnection"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PushConnection"]
    }
  ],

  "workflows": [
    {
      "name": "mini-flow-engine",
      "binding": "FLOW_ENGINE",
      "class_name": "FlowEngine"
    }
  ],

  "triggers": {
    "crons": ["*/15 * * * *"]
  },

  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
}